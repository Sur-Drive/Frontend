# SurDrive Admin — environment variables used by the code.
# Copy to .env.local and fill in real values. Never commit real secrets.

# Base URL of the backend API (read in api.ts; falls back to http://localhost:3000)
NEXT_PUBLIC_API_URL=

# Google Maps JavaScript API key (read in googleMaps.ts)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
